# Private planning documents and internal notes
*.docx
*.local.md

# Third-party material: copyrighted papers, cloned repositories
sources-citations/
code/

# Datasets and download logs (public data, ~182 GB; see scripts/download_data.py)
data/
data_*.log
*_checksum.log

# Environments and caches
.venv/
.venv-*/
__pycache__/
.pytest_cache/

# Large or machine-specific run outputs (scores are regenerated by the runner)
runs/**/*.npz
runs/**/*.log
runs/**/*.claim
runs/**/*.tmp
runs/ahlawat_check/processed_chb_mit/
runs/ahlawat_check/chb-mit-scalp-eeg-database-1.0.0
